                    CALL_SUFFIX
                      VALUE_ARGUMENTS
                        L_PAREN "("
                        VALUE_ARGUMENT
                          EXPRESSION
                            POSTFIX_UNARY_EXPRESSION
                              SIMPLE_IDENTIFIER
                                IDENT "x"
                        COMMA ","
                        VALUE_ARGUMENT
                          EXPRESSION
                            POSTFIX_UNARY_EXPRESSION
                              SIMPLE_IDENTIFIER
                                IDENT "y"
                        R_PAREN ")"
            WHITESPACE " "
            R_CURL "}"
  NEWLINE "\n"
